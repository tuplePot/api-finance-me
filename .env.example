# Salin jadi .env lalu isi nilainya.

# Neon — connection string POOLED (host berakhiran -pooler) untuk server.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon — connection string DIRECT (tanpa -pooler) untuk migrasi. Kosong = pakai DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Wajib. Harus sama dengan VITE_API_KEY di josh-vault (dikirim lewat header X-API-Key).
API_KEY=change-me

PORT=5080
# Zona waktu untuk "hari ini" (minggu budget, deadline challenge).
TIMEZONE=Asia/Jakarta
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Jalankan migrasi otomatis saat server start.
AUTO_MIGRATE=true
LOG_LEVEL=info
LOG_FORMAT=text
